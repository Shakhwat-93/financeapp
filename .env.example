# ==============================================================================
# ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to .env.local and fill in values. DO NOT commit actual secrets.
# ==============================================================================

# Public Client-side Supabase URL & Anon Key
NEXT_PUBLIC_SUPABASE_URL=http://your-supabase-host.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_token_here

# Server-side Master Service Role Key (Keep strictly server-side)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_token_here

# Dedicated Schema / Application Namespace
SUPABASE_SCHEMA=fintech_app

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_dedicated_receipts_bucket
R2_PUBLIC_URL=https://your-r2-public-domain.r2.dev
